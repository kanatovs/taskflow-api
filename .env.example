# Host ports are published on 127.0.0.1 only.
API_PORT=8080
POSTGRES_PORT=5432

# Compose fixes HTTP_ADDR to :8080 inside the API container.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
# Shared processing budget; must be shorter than HTTP_WRITE_TIMEOUT.
HTTP_REQUEST_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Keep this longer than HTTP_SHUTDOWN_TIMEOUT to allow graceful shutdown.
API_STOP_GRACE_PERIOD=30s

# Example credentials for local development only. Do not use real credentials.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=local_example_only

# Set DATABASE_URL in the process environment for go run on the host.
# postgres://taskflow:local_example_only@127.0.0.1:5432/taskflow?sslmode=disable
# Both api and migrate derive the same Compose URL when DATABASE_URL is unset.
# An explicit Compose DATABASE_URL must use postgres:5432, not localhost.
# Remove a host-only DATABASE_URL override before running Docker Compose.
# URL-encode special characters in credentials when providing an explicit URL.
DATABASE_TIMEOUT=3s

# Public local example only. Replace it with a random secret for any deployment.
JWT_SECRET=local_example_only_change_me_32_bytes_minimum
JWT_ACCESS_TTL=15m

# Optional cache. Compose uses redis:6379; use 127.0.0.1:<published-port> on host.
# Set REDIS_ADDR empty to disable caching. Redis has no public port by default.
REDIS_ADDR=redis:6379
# Empty for disposable local Redis. Configure server authentication separately.
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=1m
REDIS_DIAL_TIMEOUT=200ms
REDIS_OPERATION_TIMEOUT=100ms
