# Host ports are published on 127.0.0.1 only.
API_PORT=8080
POSTGRES_PORT=5432

# Compose fixes HTTP_ADDR to :8080 inside the API container.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Keep this longer than HTTP_SHUTDOWN_TIMEOUT to allow graceful shutdown.
API_STOP_GRACE_PERIOD=30s

# Example credentials for local development only. Do not use real credentials.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=local_example_only
